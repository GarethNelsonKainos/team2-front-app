<div class="card card-shadow my-3">
    <div class="card-header kainos-bold kainos-blue text-white with-border-bottom fs-4">
        My Recent Applications
        <% if (slice) { %>
            <a href="/profile" class="kainos-font text-white float-end">View All Applications</a>
        <% } %>
    </div>
    
    <div class="table-responsive" style="max-height: 350px; overflow-y: auto;">
        <table class="table table-hover table-striped align-middle mb-0">
            <thead class="table-light" style="position: sticky; top: 0; z-index: 1;">
                <tr>
                    <th class="kainos-bold">Role</th>
                    <th class="kainos-bold">Location</th>
                    <th class="kainos-bold">Status</th>
                    <th class="kainos-bold">Date</th>
                    <th class="text-end kainos-bold"></th>
                </tr>
            </thead>
            <tbody>
                <% if (applications && applications.length > 0) { %>
                    <% (slice ? applications.slice(0, 2) : applications).forEach(application => { %>
                        <tr>
                            <td>
                                <% if (application.jobRoleId) { %>
                                    <a href="/job-roles/<%= application.jobRoleId %>" class="kainos-blue-text kainos-bold mx-2">
                                        <%= application.jobRole?.roleName || '' %>
                                    </a>
                                <% } else { %>
                                    <span class="fw-semibold"><%= application.jobRole?.roleName || "" %></span>
                                <% } %>
                            </td>
                            <td><%= application.jobRole?.location || '' %></td>
                            <td>
                                <% if (application.status === 'IN_PROGRESS') { %>
                                    <span class="badge badge-large bg-secondary text-white">Submitted</span>
                                <% } else if (application.status === 'REJECTED') { %>
                                    <span class="badge badge-large kainos-red text-dark">Rejected</span>
                                <% } else if (application.status === 'HIRED') { %>
                                    <span class="badge badge-large kainos-green text-white">Hired</span>
                                <% } %>
                            </td>
                            <td>
                                <%= application.appliedAt ? new Date(application.appliedAt).toLocaleDateString('en-GB', { dateStyle: 'medium' }) : '—' %>
                            </td>
                            <td class="text-end">
                                <% if (application.jobRoleId) { %>
                                    <a href="/job-roles/<%= application.jobRoleId %>" class="btn btn-sm kainos-blue">See Role Details</a>
                                <% } else { %>
                                    <span class="text-muted">—</span>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">No applications found.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>