<% if (isAdmin && applications) { %>
  <table class="table">
    <thead>
      <tr>
        <th>User</th>
        <th>Job Role</th>
        <th>Location</th>
        <th>Status</th>
        <th>Applied At</th>
        <th>CV</th>
        <th></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% applications.forEach(app => { %>
        <tr>
          <td>
            <%= app.user ? `${app.user.firstName} ${app.user.secondName}` : 'Unknown User' %>
          </td>
          <td><%= app.jobRole ? app.jobRole.roleName : 'Unknown Job Role' %></td>
          <td><%= app.jobRole ? app.jobRole.location : 'Unknown Location' %></td>
          <td>
            <% if (app.status === 'IN_PROGRESS') { %>
                <span class="badge badge-large bg-secondary text-white">IN PROGRESS</span>
            <% } else if (app.status === 'REJECTED') { %>
                <span class="badge badge-large kainos-red text-dark">REJECTED</span>
            <% } else if (app.status === 'HIRED') { %>
                <span class="badge badge-large kainos-green text-white">HIRED</span>
           <% } %>
          </td>
          <td>
            <% if (app.appliedAt) { %>
              <%= new Date(app.appliedAt).toLocaleString('en-GB', {
                day: '2-digit',
                month: 'short',
                year: 'numeric',
              }) %>
            <% } %>
          </td>
          <td>
            <% if (app.cvUrl) { %>
              <a href="<%= app.cvUrl %>" class="kainos-blue-text kainos-bold" target="_blank" rel="noopener">View CV</a>
            <% } else { %>
              No CV
            <% } %>
          </td>
          <% if (app.status === 'IN_PROGRESS') { %>
            <td>
              <button class="btn btn-success fw-bold" data-bs-toggle="modal" data-bs-target="#hireModal-<%= app.id %>">Hire</button>
              <!-- Hire Confirmation Modal -->
              <div class="modal fade" id="hireModal-<%= app.id %>" tabindex="-1" aria-labelledby="hireModalLabel-<%= app.id %>" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                  <div class="modal-content">
                    <div class="modal-header">
                      <h5 class="modal-title" id="hireModalLabel-<%= app.id %>">Confirm Hire</h5>
                    </div>
                    <form method="POST" action="/applications/<%= app.id %>/status">
                      <div class="modal-body">
                        Are you sure you want to hire <%= app.user ? `${app.user.firstName} ${app.user.secondName}` : 'this applicant' %>?
                        <input type="hidden" name="status" value="HIRED">
                      </div>
                      <div class="modal-footer justify-content-center">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success">Confirm Hire</button>
                      </div>
                    </form>
                  </div>
                </div>
              </div>
            </td>
            <td>
              <button class="btn btn-danger fw-bold" data-bs-toggle="modal" data-bs-target="#rejectModal-<%= app.id %>">Reject</button>
              <!-- Reject Confirmation Modal -->
              <div class="modal fade" id="rejectModal-<%= app.id %>" tabindex="-1" aria-labelledby="rejectModalLabel-<%= app.id %>" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                  <div class="modal-content">
                    <div class="modal-header">
                      <h5 class="modal-title" id="rejectModalLabel-<%= app.id %>">Confirm Reject</h5>
                    </div>
                    <form method="POST" action="/applications/<%= app.id %>/status">
                      <div class="modal-body">
                        Are you sure you want to reject <%= app.user ? `${app.user.firstName} ${app.user.secondName}` : 'this applicant' %>?
                        <input type="hidden" name="status" value="REJECTED">
                      </div>
                      <div class="modal-footer justify-content-center">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger">Confirm Reject</button>
                      </div>
                    </form>
                  </div>
                </div>
              </div>
            </td>
          <% } else { %>
            <td></td>
            <td></td>
          <% } %>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>