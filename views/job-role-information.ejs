<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Job Role Information</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/css/styles.css">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body class="d-flex flex-column min-vh-100 bg-img kainos-font">
    <%- include('partials/navbar', { 
        showAuth: false,
        showHomeButton: true,
        pageTitle: 'Job Role Information',
        navClass: 'kainos-font'
    }) %>


    <div class="container my-5 kainos-font">
        <% if (isAdmin) { %>
            <div>
                <ul class="nav nav-tabs mb-3" id="roleTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link kainos-blue text-white" id="info-tab" data-bs-toggle="tab" data-bs-target="#info" type="button" role="tab">Role Details</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active kainos-blue text-white" id="applications-tab" data-bs-toggle="tab" data-bs-target="#applications" type="button" role="tab">Applications</button>
                    </li>
                </ul>
            </div>
            <div class="tab-content" id="roleTabsContent">
                <div class="tab-pane fade" id="info" role="tabpanel" aria-labelledby="info-tab">
                    <!-- Job Role Details (info tab content) -->
                    <%- include('partials/job-role-details', { role, success, applicationState }) %>
                </div>
                <div class="tab-pane fade show active" id="applications" role="tabpanel" aria-labelledby="applications-tab">
                    <% if (applications && applications.length > 0) { %>
                        <%- include('partials/role-applications', { applications }) %>
                    <% } else { %>
                        <div class="alert kainos-blue mt-3">No applications for this role yet.</div>
                    <% } %>
                </div>
            </div>
        <% } else { %>
            <!-- Non-admin: Show job role details directly -->
            <%- include('partials/job-role-details', { role, success, appliedForRole, applicationState }) %>
        <% } %>
    </div>

    <%- include('partials/footer') %>
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.min.js" integrity="sha384-G/EV+4j2dNv+tEPo3++6LCgdCROaejBqfUeNjuKAiuXbjrxilcCdDz6ZAVfHWe1Y" crossorigin="anonymous"></script>
</body>

</html>