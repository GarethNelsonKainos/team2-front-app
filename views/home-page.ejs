<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Home Page</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body class="d-flex flex-column min-vh-100 bg-img kainos-font">
    <%- include('partials/navbar', { 
        showAuth: true,
        showHomeButton: false, 
        user: user, 
        pageTitle: null,
        navClass: 'kainos-bold'
    }) %>
    

    <main class="container flex-grow-1 d-flex align-items-center justify-content-center kainos-font">
        <div class="row justify-content-center w-100">
            <div class="col-4 col-md-4 col-lg-4">
                <div class="card h-100 shadow">
                    <div class="card-body d-flex flex-column">
                        <h3 class="card-title">Roles</h3>
                        <p class="card-text fs-5">Browse all roles at Kainos.</p>
                        <a href="/job-roles" class="btn kainos-blue mt-auto btn-lg">View All Roles</a>
                    </div>
                </div>
            </div>
        </div>
    </main>
    <% if (user) { %>
    <div class="container my-4">
            <div class="row justify-content-center">
                <div class="col-12 col-md-8 col-lg-8">
                    <%- include('partials/my-applications', { user: user, applications: applications, slice: true }) %>
                </div>
            </div>
    </div>
    <% } %>
    <%- include('partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>