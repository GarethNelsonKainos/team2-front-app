<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Unauthorised</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body class="d-flex flex-column min-vh-100 bg-img kainos-font">
    <%- include('partials/navbar', {
      showAuth: typeof showAuth !== 'undefined' ? showAuth : true,
      showHomeButton: typeof showHomeButton !== 'undefined' ? showHomeButton : true,
      pageTitle: typeof pageTitle !== 'undefined' ? pageTitle : 'Unauthorised',
      navClass: typeof navClass !== 'undefined' ? navClass : 'kainos-font',
      token: typeof token !== 'undefined' ? token : null,
      user: typeof user !== 'undefined' ? user : null
    }) %>

    <div class="container my-5 kainos-font">
      <div class="row justify-content-center">
        <div class="col-md-6">
          <div class="card shadow rounded-4 border-danger">
            <div class="card-body text-center py-5">
              <div class="mb-4" style="font-size: 3rem;">
                <i class="bi bi-lock-fill text-danger"></i>
              </div>
              <h2 class="mb-3 text-danger">
                <strong>401 Unauthorised</strong>
              </h2>
              <p class="card-text mb-4 text-muted">
                You do not have permission to access this page. If you believe this is an error, please contact your administrator.
              </p>
              <div class="d-grid gap-2">
                <a href="/" class="btn kainos-blue">Return to Homepage</a>
                <button class="btn btn-outline-secondary" onclick="window.history.back();">Go Back</button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <%- include('partials/footer') %>
</body>

</html>
